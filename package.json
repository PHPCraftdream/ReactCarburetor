{
  "name": "react-carburetor",
  "version": "0.1.0",
  "description": "React state engine with anti-hook component: state lives outside the tree, components subscribe to the exact fields they read.",
  "main": "./dist/cjs/Carburetor/index.js",
  "module": "./dist/esm/Carburetor/index.mjs",
  "types": "./dist/cjs/Carburetor/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/Carburetor/index.d.mts",
        "default": "./dist/esm/Carburetor/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/Carburetor/index.d.ts",
        "default": "./dist/cjs/Carburetor/index.js"
      }
    },
    "./interop": {
      "import": {
        "types": "./dist/esm/Interop/index.d.mts",
        "default": "./dist/esm/Interop/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/Interop/index.d.ts",
        "default": "./dist/cjs/Interop/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware",
    "test": "rstest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PHPCraftdream/ReactCarburetor.git"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rslib/core": "^1.0.0",
    "@rstest/core": "^0.11.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "react",
    "state",
    "state-management",
    "store",
    "class-components",
    "no-hooks",
    "fine-grained",
    "reactivity",
    "proxy",
    "carburetor"
  ],
  "author": "Marat K <phpcraftdream@gmail.com>",
  "license": "MIT OR Apache-2.0",
  "bugs": {
    "url": "https://github.com/PHPCraftdream/ReactCarburetor/issues"
  },
  "homepage": "https://github.com/PHPCraftdream/ReactCarburetor#readme"
}
