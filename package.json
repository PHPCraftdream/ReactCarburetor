{
  "name": "react-carburetor",
  "version": "0.1.0",
  "description": "Fine-grained React state management with a hook-free class-component core, async resources, and native lint rules.",
  "main": "./dist/cjs/Carburetor/index.js",
  "module": "./dist/esm/Carburetor/index.mjs",
  "types": "./dist/cjs/Carburetor/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/Carburetor/index.d.mts",
        "production": "./dist/esm-prod/Carburetor/index.mjs",
        "development": "./dist/esm/Carburetor/index.mjs",
        "default": "./dist/esm/Carburetor/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/Carburetor/index.d.ts",
        "production": "./dist/cjs-prod/Carburetor/index.js",
        "development": "./dist/cjs/Carburetor/index.js",
        "default": "./dist/cjs/Carburetor/index.js"
      }
    },
    "./interop": {
      "import": {
        "types": "./dist/esm/Interop/index.d.mts",
        "production": "./dist/esm-prod/Interop/index.mjs",
        "development": "./dist/esm/Interop/index.mjs",
        "default": "./dist/esm/Interop/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/Interop/index.d.ts",
        "production": "./dist/cjs-prod/Interop/index.js",
        "development": "./dist/cjs/Interop/index.js",
        "default": "./dist/cjs/Interop/index.js"
      }
    },
    "./lint": {
      "import": {
        "types": "./dist/lint/index.d.mts",
        "default": "./dist/lint/index.mjs"
      },
      "require": {
        "types": "./dist/lint/index.d.cts",
        "default": "./dist/lint/index.cjs"
      }
    },
    "./lint/recommended.oxlintrc.json": "./dist/lint/recommended.oxlintrc.json"
  },
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14.6.0"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p plugin/tsconfig.json && tsc --noEmit -p plugin/internal/tsconfig.json && tsc --noEmit -p tsconfig.types.json",
    "lint": "oxlint --type-aware",
    "check:layout": "node scripts/checkLayout.mjs",
    "test": "rstest run",
    "test:rules": "rstest run __tests__/Plugin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PHPCraftdream/ReactCarburetor.git"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rslib/core": "^1.0.0",
    "@rstest/core": "^0.11.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "react",
    "typescript",
    "state",
    "state-management",
    "store",
    "class-components",
    "no-hooks",
    "fine-grained",
    "fine-grained-reactivity",
    "reactivity",
    "async-resources",
    "eslint-plugin",
    "oxlint",
    "proxy",
    "carburetor"
  ],
  "author": "Marat K <phpcraftdream@gmail.com>",
  "license": "MIT OR Apache-2.0",
  "bugs": {
    "url": "https://github.com/PHPCraftdream/ReactCarburetor/issues"
  },
  "homepage": "https://github.com/PHPCraftdream/ReactCarburetor#readme"
}
