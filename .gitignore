# /wrush task worktrees — always created here, in-tree
/worktrees/

# Consumer matrix: packed tarball + throwaway npm/pnpm consumer installs
/.consumer-matrix/

# Platform packages carry their compiled binary only in CI artifacts, never in git; the
# launcher script lives in npm/lint/bin/ and must stay tracked.
npm/lint-*/carburetor-lint
npm/lint-*/carburetor-lint.exe
npm/lint-*/*.tgz

# Local scratch space and Claude Code runtime state
/scratch/
/.claude/scheduled_tasks.lock
