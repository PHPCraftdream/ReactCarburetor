    "options": {
        "typeAware": true
    },
    "plugins": ["typescript", "react", "unicorn"],
    "categories": {
        "correctness": "error"
    },
    "env": {
        "browser": true,
        "node": true
    },
    "ignorePatterns": ["dist", "build", "node_modules", "lib/build", "lib/node_modules"]
}
